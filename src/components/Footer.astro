---
import settings from '../content/config/settings.json';
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-8">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-12">
      <!-- Column 1: About -->
      <div>
        <div class="mb-4">
          <img src="/images/logo-dark.png" alt="Γραφεία Ευρέσεως Εργασίας" class="h-10 w-auto" />
        </div>
        <p class="text-sm leading-relaxed text-slate-400 mb-4">
          Αδειοδοτημένο Γραφείο Ευρέσεως Εργασίας με πάνω από 30 χρόνια εμπειρίας στην Αθήνα. Εμπιστευτείτε μας για αξιόπιστη εύρεση προσωπικού.
        </p>
        <p class="text-xs text-slate-500">Αρ. Αδείας: {settings.license_number}</p>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="font-heading font-semibold text-white text-sm uppercase tracking-wider mb-4">Υπηρεσίες</h3>
        <ul class="space-y-2.5">
          <li><a href="/υπηρεσίες/#oikiako" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Οικιακό Προσωπικό</a></li>
          <li><a href="/υπηρεσίες/#touristika" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Τουριστικά Επαγγέλματα</a></li>
          <li><a href="/υπηρεσίες/#stelechosi" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Στελέχωση Επιχειρήσεων</a></li>
          <li><a href="/αγγελίες-εργασίας/" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Αγγελίες Εργασίας</a></li>
        </ul>
      </div>

      <!-- Column 3: Useful Links -->
      <div>
        <h3 class="font-heading font-semibold text-white text-sm uppercase tracking-wider mb-4">Χρήσιμα</h3>
        <ul class="space-y-2.5">
          <li><a href="/σχετικά-με-εμάς/" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Σχετικά με εμάς</a></li>
          <li><a href="/τα-νέα/" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Τα Νέα</a></li>
          <li><a href="/επικοινωνία/" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Επικοινωνία</a></li>
          <li><a href="#" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Πολιτική Απορρήτου</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="font-heading font-semibold text-white text-sm uppercase tracking-wider mb-4">Επικοινωνία</h3>
        <div class="space-y-3">
          {settings.phones.map((p: {label: string, number: string}) => (
            <a href={`tel:${p.number}`} class="flex items-center gap-2 text-sm text-slate-400 hover:text-primary-400 transition-colors">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{p.number}</span>
            </a>
          ))}
          <a href={`mailto:${settings.email}`} class="flex items-center gap-2 text-sm text-slate-400 hover:text-primary-400 transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{settings.email}</span>
          </a>
          <div class="flex items-start gap-2 text-sm text-slate-400">
            <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{settings.address}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="border-t border-slate-800 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-slate-500">
        &copy; {new Date().getFullYear()} {settings.company_name}. Όλα τα δικαιώματα κατοχυρωμένα.
      </p>

    </div>
  </div>
</footer>
