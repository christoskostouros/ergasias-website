---
import BaseLayout from '../../layouts/BaseLayout.astro';

const jobFiles = import.meta.glob('../../content/jobs/*.md', { eager: true });
const jobs = Object.values(jobFiles)
  .map((file: any) => ({ ...file.frontmatter }))
  .filter((job: any) => job.active)
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categoryLabels: Record<string, string> = {
  oikiako: 'Οικιακό Προσωπικό',
  touristika: 'Τουριστικά Επαγγέλματα',
  stelechosi: 'Στελέχωση Επιχειρήσεων',
};

const categoryColors: Record<string, string> = {
  oikiako: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  touristika: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  stelechosi: 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
};

const categories = ['all', 'oikiako', 'touristika'];
---

<BaseLayout title="Αγγελίες Εργασίας" description="Δείτε τις τελευταίες θέσεις εργασίας. Οικιακό προσωπικό, τουριστικά, στελέχωση επιχειρήσεων.">

  <!-- Page Hero -->
  <section class="pt-20 pb-12 bg-slate-50 dark:bg-surface-dark-alt">
    <div class="section-container text-center">
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">
        Αγγελίες Εργασίας
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-body">
        Βρείτε την ιδανική θέση εργασίας ή το κατάλληλο προσωπικό
      </p>
    </div>
  </section>

  <!-- Filters -->
  <section class="bg-white dark:bg-surface-dark border-b border-slate-200 dark:border-slate-700 py-6">
    <div class="section-container">
      <div class="flex flex-wrap gap-3" id="filter-bar">
        {categories.map((cat) => (
          <button
            class="filter-btn px-4 py-2 rounded-xl text-sm font-heading font-medium transition-all"
            data-category={cat}
          >
            {cat === 'all' ? 'Όλες' : categoryLabels[cat]}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Jobs Grid -->
  <section class="section-padding">
    <div class="section-container">
      {jobs.length === 0 ? (
        <div class="text-center py-16">
          <svg class="w-16 h-16 mx-auto text-slate-300 dark:text-slate-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <h3 class="text-xl font-heading font-semibold text-slate-700 dark:text-slate-300 mb-2">Δεν υπάρχουν αγγελίες αυτή τη στιγμή</h3>
          <p class="text-slate-500 dark:text-slate-400 font-body">Ελέγξτε ξανά σύντομα ή επικοινωνήστε μαζί μας.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="jobs-grid">
          {jobs.map((job: any) => (
            <a
              href={`/αγγελίες-εργασίας/${job.slug}/`}
              class="card p-6 group job-card animate-on-scroll"
              data-category={job.category}
            >
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${categoryColors[job.category] || ''}`}>
                  {categoryLabels[job.category] || job.category}
                </span>
              </div>
              <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-white mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {job.title}
              </h3>
              <div class="space-y-2 text-sm text-slate-600 dark:text-slate-400 mb-4">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{job.location}</span>
                </div>
                {job.salary && (
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{job.salary}</span>
                  </div>
                )}
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{new Date(job.date).toLocaleDateString('el-GR')}</span>
                </div>
              </div>
              <span class="text-sm font-medium text-primary-600 dark:text-primary-400 flex items-center gap-1 group-hover:gap-2 transition-all">
                Δείτε περισσότερα
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Filter Script -->
  <script is:inline>
    (function() {
      var btns = document.querySelectorAll('.filter-btn');
      var cards = document.querySelectorAll('.job-card');
      var active = 'all';

      function update() {
        btns.forEach(function(b) {
          if (b.dataset.category === active) {
            b.classList.add('bg-primary-100', 'dark:bg-primary-900/30', 'text-primary-700', 'dark:text-primary-300');
            b.classList.remove('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
          } else {
            b.classList.remove('bg-primary-100', 'dark:bg-primary-900/30', 'text-primary-700', 'dark:text-primary-300');
            b.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
          }
        });
        cards.forEach(function(c) {
          if (active === 'all' || c.dataset.category === active) {
            c.style.display = '';
          } else {
            c.style.display = 'none';
          }
        });
      }

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          active = this.dataset.category;
          update();
        });
      });

      update();
    })();
  </script>
</BaseLayout>
