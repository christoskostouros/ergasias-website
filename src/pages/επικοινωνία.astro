---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../content/config/settings.json';
---

<BaseLayout title="Επικοινωνία" description="Επικοινωνήστε με το Γραφείο Ευρέσεως Εργασίας ΛΟΥΚΙΑ ΤΣΙΩΤΑ στην Αθήνα. Τηλέφωνο, email, φόρμα επικοινωνίας.">

  <section class="pt-20 pb-12 bg-slate-50 dark:bg-surface-dark-alt">
    <div class="section-container text-center">
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">
        Επικοινωνία
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-body">
        Είμαστε εδώ για να σας βοηθήσουμε. Επικοινωνήστε μαζί μας.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Contact Info + Form -->
        <div>
          <!-- Contact Details -->
          <div class="mb-10">
            <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white mb-6">
              Στοιχεία Επικοινωνίας
            </h2>
            <div class="space-y-5">
              <!-- Phones -->
              {settings.phones.map((p: {label: string, number: string}) => (
                <a href={`tel:${p.number}`} class="flex items-center gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center shrink-0 group-hover:bg-primary-100 dark:group-hover:bg-primary-900/40 transition-colors">
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-body">{p.label}</p>
                    <p class="text-base font-heading font-semibold text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{p.number}</p>
                  </div>
                </a>
              ))}

              <!-- Email -->
              <a href={`mailto:${settings.email}`} class="flex items-center gap-4 group">
                <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center shrink-0 group-hover:bg-primary-100 dark:group-hover:bg-primary-900/40 transition-colors">
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-slate-400 font-body">Email</p>
                  <p class="text-base font-heading font-semibold text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{settings.email}</p>
                </div>
              </a>

              <!-- Address -->
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-slate-400 font-body">Διεύθυνση</p>
                  <p class="text-base font-heading font-semibold text-slate-900 dark:text-white">{settings.address}</p>
                </div>
              </div>

              <!-- Working Hours -->
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-slate-400 font-body">Ωράριο</p>
                  <p class="text-base font-heading font-semibold text-slate-900 dark:text-white">{settings.working_hours}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="card p-8">
            <h2 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-6">
              Φόρμα Επικοινωνίας
            </h2>
            <form id="contact-form" class="space-y-5">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Ονοματεπώνυμο</label>
                <input type="text" id="name" name="name" required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-surface-dark-alt text-slate-900 dark:text-white font-body placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
                  placeholder="Το ονοματεπώνυμό σας" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Email</label>
                  <input type="email" id="email" name="email" required
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-surface-dark-alt text-slate-900 dark:text-white font-body placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
                    placeholder="email@example.com" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Τηλέφωνο</label>
                  <input type="tel" id="phone" name="phone"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-surface-dark-alt text-slate-900 dark:text-white font-body placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
                    placeholder="69xxxxxxxx" />
                </div>
              </div>

              <div>
                <label for="type" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Είμαι</label>
                <select id="type" name="type" required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-surface-dark-alt text-slate-900 dark:text-white font-body focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                  <option value="">Επιλέξτε...</option>
                  <option value="employer">Εργοδότης - Χρειάζομαι Προσωπικό</option>
                  <option value="jobseeker">Εργαζόμενος - Ψάχνω Δουλειά</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Μήνυμα</label>
                <textarea id="message" name="message" rows="4" required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-surface-dark-alt text-slate-900 dark:text-white font-body placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all resize-none"
                  placeholder="Πείτε μας πώς μπορούμε να σας βοηθήσουμε..."></textarea>
              </div>

              <button type="submit" class="btn-primary w-full" id="submit-btn">
                Αποστολή Μηνύματος
              </button>

              <div id="form-status" class="hidden text-center text-sm font-body p-4 rounded-xl"></div>
            </form>
          </div>
        </div>

        <!-- Map -->
        <div class="lg:sticky lg:top-28 h-fit">
          <div class="card overflow-hidden">
            <div class="aspect-square lg:aspect-auto lg:h-[600px]">
              <iframe
                src={settings.map_url}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Τοποθεσία γραφείου"
                class="w-full h-full"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Form Script -->
  <script is:inline>
    // Pre-fill from URL params
    (function() {
      var params = new URLSearchParams(window.location.search);
      var type = params.get('type');
      if (type) {
        var sel = document.getElementById('type');
        if (sel) sel.value = type;
      }
    })();

    // Form submission (AJAX simulation)
    document.getElementById('contact-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('submit-btn');
      var status = document.getElementById('form-status');
      
      btn.disabled = true;
      btn.textContent = 'Αποστολή...';
      
      // Simulate AJAX call
      setTimeout(function() {
        status.classList.remove('hidden');
        status.classList.add('bg-emerald-50', 'dark:bg-emerald-900/30', 'text-emerald-700', 'dark:text-emerald-300');
        status.textContent = 'Το μήνυμά σας εστάλη επιτυχώς! Θα επικοινωνήσουμε σύντομα μαζί σας.';
        btn.textContent = 'Αποστολή Μηνύματος';
        btn.disabled = false;
        e.target.reset();
      }, 1500);
    });
  </script>
</BaseLayout>
