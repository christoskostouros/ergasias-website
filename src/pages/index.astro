---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../content/config/settings.json';

// Load jobs
const jobFiles = import.meta.glob('../content/jobs/*.md', { eager: true });
const jobs = Object.values(jobFiles)
  .map((file: any) => ({ ...file.frontmatter, content: file.compiledContent?.() || '' }))
  .filter((job: any) => job.active)
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  oikiako: 'Οικιακό Προσωπικό',
  touristika: 'Τουριστικά',
  stelechosi: 'Στελέχωση',
};

const categoryColors: Record<string, string> = {
  oikiako: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  touristika: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  stelechosi: 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
};

const testimonials = [
  { text: 'Βρήκαμε εξαιρετική γηροκόμο για τη μητέρα μας μέσα σε λίγες μέρες. Πολύ αξιόπιστη υπηρεσία.', name: 'Μαρία Κ.', role: 'Εργοδότης' },
  { text: 'Με βοήθησαν να βρω δουλειά σε μεγάλο ξενοδοχείο. Επαγγελματική αντιμετώπιση από την πρώτη στιγμή.', name: 'Νίκος Π.', role: 'Εργαζόμενος' },
  { text: 'Συνεργαζόμαστε πάνω από 10 χρόνια. Πάντα μας βρίσκουν το κατάλληλο προσωπικό.', name: 'Εστιατόριο "Θαλασσινός"', role: 'Εταιρικός Πελάτης' },
  { text: 'Η εγγύηση αντικατάστασης μας έδωσε σιγουριά. Εξαιρετική εξυπηρέτηση.', name: 'Ελένη Μ.', role: 'Εργοδότης' },
];
---

<BaseLayout title="Αρχική">

  <!-- Hero Section -->
  <section class="relative hero-pattern geo-grid min-h-[85vh] flex items-center overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary-500/5 dark:bg-primary-400/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-primary-500/8 dark:bg-primary-400/8 rounded-full blur-3xl"></div>

    <div class="section-container relative z-10 py-20 lg:py-28">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 text-sm font-medium mb-8 animate-on-scroll">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Αδειοδοτημένο Γραφείο | Αρ. Αδείας {settings.license_number}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold text-slate-900 dark:text-white leading-[1.1] mb-6 animate-on-scroll">
          Εύρεση Προσωπικού.<br/>
          Εύρεση Εργασίας.<br/>
          <span class="text-primary-600 dark:text-primary-400">Εμπιστευτικά & Επαγγελματικά.</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-10 animate-on-scroll font-body leading-relaxed">
          Με πάνω από {settings.years_experience} χρόνια εμπειρίας, συνδέουμε εργοδότες με αξιόπιστο προσωπικό και εργαζόμενους με ιδανικές θέσεις εργασίας.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll">
          <a href="/επικοινωνία/?type=employer" class="btn-primary text-lg px-10 py-5">
            Χρειάζομαι Προσωπικό
          </a>
          <a href="/αγγελίες-εργασίας/" class="btn-outline text-lg px-10 py-5">
            Ψάχνω για Δουλειά
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="section-padding bg-slate-50 dark:bg-surface-dark-alt">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="card p-8 text-center animate-on-scroll">
          <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-2">30+</div>
          <div class="text-sm font-body text-slate-600 dark:text-slate-400">Χρόνια Εμπειρίας</div>
        </div>

        <div class="card p-8 text-center animate-on-scroll">
          <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-2">30499</div>
          <div class="text-sm font-body text-slate-600 dark:text-slate-400">Αριθμός Αδείας</div>
        </div>

        <div class="card p-8 text-center animate-on-scroll">
          <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-2">1000+</div>
          <div class="text-sm font-body text-slate-600 dark:text-slate-400">Επιτυχημένες Τοποθετήσεις</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section-padding">
    <div class="section-container">
      <div class="text-center mb-14 animate-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">
          Οι Υπηρεσίες μας
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-body">
          Τρεις πυλώνες υπηρεσιών που καλύπτουν κάθε ανάγκη εύρεσης προσωπικού
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Οικιακό Προσωπικό -->
        <a href="/υπηρεσίες/#oikiako" class="card p-8 group animate-on-scroll">
          <div class="w-16 h-16 mb-6 rounded-2xl bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-3">Οικιακό Προσωπικό</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 font-body leading-relaxed">
            Γηροκόμοι, νταντάδες, οικιακοί βοηθοί, καθαρίστριες, νοσηλευτές. Αξιόπιστο προσωπικό για κάθε ανάγκη του σπιτιού σας.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 group-hover:gap-2 transition-all">
            Περισσότερα
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>

        <!-- Τουριστικά -->
        <a href="/υπηρεσίες/#touristika" class="card p-8 group animate-on-scroll">
          <div class="w-16 h-16 mb-6 rounded-2xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5M3.75 3v18m16.5-18v18M5.25 3h13.5M5.25 21h13.5M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-3">Τουριστικά Επαγγέλματα</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 font-body leading-relaxed">
            Σεφ, μάγειρες, σερβιτόροι, καμαριέρες, ρεσεψιονίστ. Πλήρης στελέχωση ξενοδοχείων και εστιατορίων.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 group-hover:gap-2 transition-all">
            Περισσότερα
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>

        <!-- Στελέχωση -->
        <a href="/υπηρεσίες/#stelechosi" class="card p-8 group animate-on-scroll">
          <div class="w-16 h-16 mb-6 rounded-2xl bg-violet-50 dark:bg-violet-900/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-3">Στελέχωση Επιχειρήσεων</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 font-body leading-relaxed">
            Γραμματείς, πωλητές, υπάλληλοι γραφείου. Εξειδικευμένο διοικητικό προσωπικό για κάθε επιχείρηση.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 group-hover:gap-2 transition-all">
            Περισσότερα
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Jobs -->
  <section class="section-padding bg-slate-50 dark:bg-surface-dark-alt">
    <div class="section-container">
      <div class="text-center mb-14 animate-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">
          Τελευταίες Αγγελίες
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-body">
          Δείτε τις πιο πρόσφατες θέσεις εργασίας
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {jobs.map((job: any) => (
          <a href={`/αγγελίες-εργασίας/${job.slug}/`} class="card p-6 group animate-on-scroll">
            <div class="flex items-center gap-2 mb-3">
              <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${categoryColors[job.category] || ''}`}>
                {categoryLabels[job.category] || job.category}
              </span>
              <span class="text-xs text-slate-500 dark:text-slate-400">{new Date(job.date).toLocaleDateString('el-GR')}</span>
            </div>
            <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {job.title}
            </h3>
            <div class="flex items-center gap-4 text-sm text-slate-600 dark:text-slate-400 mb-3">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {job.location}
              </span>
              {job.salary && (
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {job.salary}
                </span>
              )}
            </div>
            <span class="text-sm font-medium text-primary-600 dark:text-primary-400">
              Δείτε περισσότερα &rarr;
            </span>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/αγγελίες-εργασίας/" class="btn-outline">
          Δείτε όλες τις Αγγελίες
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-padding">
    <div class="section-container">
      <div class="text-center mb-14 animate-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">
          Τι Λένε οι Πελάτες μας
        </h2>
      </div>

      <div class="relative overflow-hidden" id="testimonial-carousel">
        <div class="testimonial-track" id="testimonial-track">
          {testimonials.map((t, i) => (
            <div class="min-w-full md:min-w-[50%] lg:min-w-[33.333%] px-3">
              <div class="card p-8 h-full">
                <div class="flex gap-1 mb-4">
                  {[...Array(5)].map(() => (
                    <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="text-slate-700 dark:text-slate-300 font-body leading-relaxed mb-4 italic">
                  "{t.text}"
                </blockquote>
                <div>
                  <p class="font-heading font-semibold text-slate-900 dark:text-white text-sm">{t.name}</p>
                  <p class="text-xs text-slate-500 dark:text-slate-400">{t.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Carousel controls -->
        <div class="flex justify-center gap-2 mt-6">
          {testimonials.map((_, i) => (
            <button
              class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-slate-600 transition-colors testimonial-dot"
              data-index={i}
              aria-label={`Μαρτυρία ${i + 1}`}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="py-16 bg-primary-600 dark:bg-primary-700">
    <div class="section-container text-center">
      <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-white mb-4">
        Επικοινωνήστε μαζί μας σήμερα
      </h2>
      <p class="text-lg text-primary-100 mb-8 max-w-2xl mx-auto font-body">
        Δωρεάν αρχική συμβουλευτική. Βρείτε το κατάλληλο προσωπικό ή τη δουλειά που ψάχνετε.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/επικοινωνία/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary-700 font-heading font-semibold rounded-xl hover:bg-primary-50 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5">
          Φόρμα Επικοινωνίας
        </a>
        <a href={`tel:${settings.phones[0]?.number}`} class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white text-white font-heading font-semibold rounded-xl hover:bg-white/10 transition-all duration-300">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {settings.phones[0]?.number}
        </a>
      </div>
    </div>
  </section>

  <!-- Carousel Script -->
  <script is:inline>
    (function() {
      var track = document.getElementById('testimonial-track');
      var dots = document.querySelectorAll('.testimonial-dot');
      var current = 0;
      var total = dots.length;

      function goTo(index) {
        current = index;
        var isMobile = window.innerWidth < 768;
        var isTablet = window.innerWidth < 1024;
        var slideWidth = isMobile ? 100 : isTablet ? 50 : 33.333;
        track.style.transform = 'translateX(-' + (current * slideWidth) + '%)';
        dots.forEach(function(d, i) {
          d.classList.toggle('bg-primary-500', i === current);
          d.classList.toggle('dark:bg-primary-400', i === current);
          d.classList.toggle('bg-slate-300', i !== current);
          d.classList.toggle('dark:bg-slate-600', i !== current);
        });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          goTo(parseInt(this.dataset.index));
        });
      });

      goTo(0);

      setInterval(function() {
        goTo((current + 1) % total);
      }, 5000);
    })();
  </script>
</BaseLayout>
